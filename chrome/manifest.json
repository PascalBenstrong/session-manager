{
  "manifest_version": 3,
  "name": "Session Manager",
  "version": "0.7.0",
  "description": "Track tabs in sessions, search and organize them, and clean cookies & site data.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "cookies",
    "browsingData",
    "alarms",
    "tabGroups",
    "clipboardRead",
    "sidePanel",
    "scripting",
    "declarativeNetRequest",
    "contextMenus",
    "clipboardWrite",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "media.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Session Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open the Session Manager quick switcher"
    },
    "open-sidebar": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Open the workspace side panel"
    },
    "open-inspector": {
      "suggested_key": {
        "default": "Alt+Shift+I"
      },
      "description": "Inspect the current page (in a window, or docked at the bottom of the page)"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "inspector.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
